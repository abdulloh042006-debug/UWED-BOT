# Set these as server-side runtime secrets only. Never use NEXT_PUBLIC_ or commit values.
TELEGRAM_BOT_TOKEN=replace-in-runtime-secret-store
TELEGRAM_WEBHOOK_SECRET=replace-in-runtime-secret-store
SESSION_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_TELEGRAM_ID=replace-with-verified-numeric-id
MINIAPP_URL=https://real-approved-deployment-url.example
# Optional Gemini. The model name is configured only after confirming availability.
GEMINI_API_KEY=optional-server-side-key
GEMINI_MODEL=optional-available-model-name
